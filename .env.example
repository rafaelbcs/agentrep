# AgentRep — Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to git.

# ─── Database (PostgreSQL) ────────────────────────────────────────────────────
DB_URL=jdbc:postgresql://localhost:5434/agentrep
DB_USERNAME=agentrep
DB_PASSWORD=your_db_password

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=

# ─── Anthropic (LLM Judge) ────────────────────────────────────────────────────
# Get your key at: https://console.anthropic.com/api-keys
ANTHROPIC_API_KEY=sk-ant-...

# ─── Blockchain (Base L2) ─────────────────────────────────────────────────────
# Mainnet RPC: https://mainnet.base.org or via Alchemy/QuickNode
# Testnet RPC: https://sepolia.base.org
BASE_RPC_URL=https://sepolia.base.org

# Chain ID: 8453 = Base Mainnet, 84532 = Base Sepolia
CHAIN_ID=84532

# Contract address after deploying AgentRepRegistry.sol
CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Deployer wallet private key (without 0x prefix is also accepted)
# Use a dedicated deployer wallet — never your main wallet
DEPLOYER_PRIVATE_KEY=your_deployer_private_key

# Treasury wallet that receives x402 fees
TREASURY_ADDRESS=0x0000000000000000000000000000000000000000

# USDC contract on Base Sepolia (testnet)
USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# ─── Security ─────────────────────────────────────────────────────────────────
# JWT secret — minimum 32 characters, use a random string in production
JWT_SECRET=change-this-to-a-random-secret-at-least-32-chars

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_OUTCOME=10
RATE_LIMIT_DISPUTE=5
RATE_LIMIT_REGISTER=3

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=8080
